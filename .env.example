# Copy this file to .env and fill in real values.
# Real values are stored in 1Password / shared secrets vault.
#
# EXPO_PUBLIC_* prefix is REQUIRED for Expo to expose these to client code.
# Variables without this prefix won't be readable in src/.
#
# Values are baked into the JS bundle at build time, so changing them
# requires a new build (not just a JS reload).

# ─── Supabase (public — RLS protects data) ─────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── PostHog Analytics (public — ingest-only) ──────────────────────────────
# Leave POSTHOG_API_KEY empty to disable analytics in this environment.
EXPO_PUBLIC_POSTHOG_API_KEY=phc_yourtokenhere
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── RevenueCat (public, added in a future PR) ─────────────────────────────
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_yourkeyhere
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_yourkeyhere

# ─── Server-only secrets (DO NOT add to this file) ─────────────────────────
# ANTHROPIC_API_KEY — set via:  supabase secrets set ANTHROPIC_API_KEY=...
#   Used only in supabase/functions/_shared/claude.ts
#   NEVER add a Tier 2 secret to this file or it ends up in the APK bundle.

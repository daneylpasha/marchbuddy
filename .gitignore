# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Google Service Account Key (sensitive credentials - never commit)
google-service-account.json
google-sa-key.json
marchbuddy-*.json
!marchbuddy-*.json.example

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — .env holds real values per environment (gitignored).
# .env.example is committed and documents the required variable names with
# placeholder values; copy to .env locally and fill in.
.env
.env.*
!.env.example
.env.supabase
supabase/.temp/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Android release signing (NEVER commit — contains private keystore + passwords)
android/app/release.keystore
android/gradle.properties

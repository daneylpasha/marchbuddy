{
  "expo": {
    "name": "March Buddy",
    "slug": "march-buddy",
    "owner": "rendernext",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "marchbuddy",
    "splash": {
      "image": "./assets/splash-empty.png",
      "imageWidth": 1,
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.marchbuddy.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "MarchBuddy needs your location to track your walk/run distance and route.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "MarchBuddy needs your location to track your walk/run distance and route, even when the app is in the background.",
        "NSMotionUsageDescription": "MarchBuddy uses motion data to count your steps during walks and runs — works even indoors and on treadmills.",
        "UIBackgroundModes": ["location", "audio"]
      }
    },
    "android": {
      "versionCode": 61,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a1a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "package": "com.marchbuddy.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD4t8YyKVrNuZaYzZW4qj0qmTmycjamwao"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.WRITE_DISTANCE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-empty.png",
          "imageWidth": 1,
          "backgroundColor": "#000000",
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MarchBuddy needs your location to track your walk/run distance and route."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "MarchBuddy needs photo library access to save your session share card.",
          "savePhotosPermission": "MarchBuddy needs permission to save images to your gallery."
        }
      ],
      "expo-web-browser",
      "expo-updates",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "react-native-health",
        {
          "healthSharePermission": "MarchBuddy uses your health data to provide personalised coaching.",
          "healthUpdatePermission": "MarchBuddy saves your workout sessions to Apple Health to keep your fitness data in sync."
        }
      ],
      "react-native-health-connect",
      "./plugins/withHealthConnectDelegate",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "068b87b8-7c39-40b5-af36-e4ced0a3c81e"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/068b87b8-7c39-40b5-af36-e4ced0a3c81e"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
